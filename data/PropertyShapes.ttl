ceds:hasAssessmentNeedHazardTypeShape
  a sh:PropertyShape ;
  sh:path ceds:P001024 ;
  sh:name "Has Assessment Need Hazard Type" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI001024115751    # Flashing
    ceds:NI001024116144    # Motion simulation
    ceds:NI001024116320    # Olfactory
    ceds:NI001024116877    # Sound
  ) ;
.

