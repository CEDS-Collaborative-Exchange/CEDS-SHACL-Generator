ceds:AcademicAwardDateShape
  a sh:PropertyShape ;
  sh:path ceds:P000001 ;
  sh:name "Academic Award Date" ;
  sh:datatype xsd:string ;
.

ceds:hasAcademicAwardLevelConferredShape
  a sh:PropertyShape ;
  sh:path ceds:P000002 ;
  sh:name "Has Academic Award Level Conferred" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI000002113286    # Postsecondary award, certificate, or diploma of less than 1 academic year
    ceds:NI000002113290    # Postsecondary award, certificate, or diploma of at least 1 but less than 2 academic years
    ceds:NI000002113292    # Associate's Degree
    ceds:NI000002113298    # Postsecondary award, certificate, or diploma of at least 2 but less than 4 academic years
    ceds:NI000002113300    # Bachelor's Degree
    ceds:NI000002113304    # Postbaccalaureate Certificate
    ceds:NI000002113308    # Master's Degree
    ceds:NI000002113314    # Post-Master's Certificate
    ceds:NI000002113332    # Doctor's Degree-Research/Scholarship
    ceds:NI000002113336    # Doctor's Degree-Professional Practice
    ceds:NI000002113340    # Doctor's Degree-Other
  ) ;
.

