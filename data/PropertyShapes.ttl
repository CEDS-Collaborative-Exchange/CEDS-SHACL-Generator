ceds:hasAssessmentNeedSigningTypeShape
  a sh:PropertyShape ;
  sh:path ceds:P001040 ;
  sh:name "Has Assessment Need Signing Type" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI001040115274    # American Sign Language
    ceds:NI001040116862    # Signed English
  ) ;
.

ceds:hasAssessmentNeedAlternativeRepresentationTypeShape
  a sh:PropertyShape ;
  sh:path ceds:P001041 ;
  sh:name "Has Assessment Need Alternative Representation Type" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI001041115313    # Audio
    ceds:NI001041115814    # Graphic
    ceds:NI001041115946    # Interactive
    ceds:NI001041117031    # Text
    ceds:NI001041117150    # Video
  ) ;
.

ceds:hasAssessmentNeedSpokenSourcePreferenceTypeShape
  a sh:PropertyShape ;
