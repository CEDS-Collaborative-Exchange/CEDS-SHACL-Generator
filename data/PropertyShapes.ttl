ceds:hasAccessibilityFeaturePausesTheClockIndicatorShape
  a sh:PropertyShape ;
  sh:path ceds:P002172 ;
  sh:name "Has Accessibility Feature Pauses the Clock Indicator" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI002172190500    # No
    ceds:NI002172190501    # Yes
  ) ;
.

ceds:hasAccessibilityFeatureRelationshipTypeShape
  a sh:PropertyShape ;
  sh:path ceds:P002173 ;
  sh:name "Has Accessibility Feature Relationship Type" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI002173190502    # Complementary
    ceds:NI002173190503    # Dependent
    ceds:NI002173190504    # Enhancing
    ceds:NI002173190505    # Interdependent
    ceds:NI002173190506    # Supporting
  ) ;
.

