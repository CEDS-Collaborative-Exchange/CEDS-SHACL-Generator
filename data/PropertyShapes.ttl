ceds:FiscalYearShape
  a sh:PropertyShape ;
  sh:path ceds:P001639 ;
  sh:name "Fiscal Year" ;
  sh:datatype xsd:gYear ;
.

ceds:hasMilitaryBranchShape
  a sh:PropertyShape ;
  sh:path ceds:P001640 ;
  sh:name "Has Military Branch" ;
  sh:nodeKind sh:IRI ;
  sh:in (
    ceds:NI001640151056    # Army
    ceds:NI001640151057    # Navy
    ceds:NI001640151058    # Air Force
    ceds:NI001640151059    # Marine Corps
    ceds:NI001640151060    # Coast Guard
    ceds:NI001640151061    # Space Force
  ) ;
.

